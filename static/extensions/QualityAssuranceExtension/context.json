{
  "@context": {
    "obi": "https://w3id.org/openbadges#",
    "extensions": "https://w3id.org/openbadges/extensions#",
    "qualityAssuranceName": "extensions:qualityAssuranceName",
    "qualityAssuranceUrl": {
      "@id": "extensions:qualityAssuranceUrl",
      "@type": "@id"
    },
    "qualityAssuranceDescription": "extensions:qualityAssuranceDescription"
  },
  "obi:validation": [
    {
      "obi:validatesType": "extensions:qualityAssuranceName",
      "obi:validationSchema": "${BASE_URL}/static/extensions/QualityAssuranceExtension/schema.json"
    }
  ]
}